# ---- Local OLTP (Postgres) ----
POSTGRES_DB=novamart
POSTGRES_USER=nova
POSTGRES_PASSWORD=nova
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
NOVAMART_DSN=postgresql://nova:nova@localhost:5432/novamart

# ---- Object storage (MinIO local / S3 cloud) ----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=novamart-lake
AWS_REGION=us-east-1

# ---- Kafka / Connect ----
KAFKA_BOOTSTRAP=localhost:9092
CONNECT_URL=http://localhost:8083

# ---- Databricks (cloud) ----
DATABRICKS_HOST=https://dbc-xxxxxxxx.cloud.databricks.com
DATABRICKS_TOKEN=dapi_xxxxxxxxxxxxxxxx
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxx
DATABRICKS_CATALOG=novamart
DATABRICKS_SCHEMA=gold
